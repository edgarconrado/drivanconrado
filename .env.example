# Copia este archivo como `.env` y completa los valores (Google Ads > Herramientas > Etiqueta de Google).
# Sin VITE_GOOGLE_ADS_ID el sitio NO carga la etiqueta de Google Ads.
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Opcionales: etiquetas de conversión (la parte después de "/" en AW-XXXXXXXXXX/ETIQUETA)
VITE_ADS_LABEL_CALL=
VITE_ADS_LABEL_WHATSAPP=
VITE_ADS_LABEL_FORM=
